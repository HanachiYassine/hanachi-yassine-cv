# Copier ce fichier vers .env dans backend/. Ne jamais publier les secrets.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=cv.local.db
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200

# Pour utiliser Turso, même depuis votre PC : DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Créés seulement si la base ne contient aucun compte administrateur.
ADMIN_EMAIL=
ADMIN_PASSWORD=
