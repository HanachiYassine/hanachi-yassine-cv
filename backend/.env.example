# Copier ce fichier vers .env dans backend/. Ne jamais publier les secrets.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=cv.local.db
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200

# Pour utiliser Turso, même depuis votre PC : DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=libsql://cv-hanachiyassine.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=

# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Créés seulement si la base ne contient aucun compte administrateur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Récupération administrateur : clé privée à conserver uniquement dans le backend.
RESEND_API_KEY=
# Origine publique HTTPS du site ; le lien ne dépend jamais du Host de la requête.
ADMIN_APP_URL=https://hanachiyassine.netlify.app
# Domaine de test Resend : seul l’e-mail du propriétaire du compte Resend est accepté.
# Pour d’autres destinataires, remplacer par une adresse d’un domaine vérifié.
RESET_EMAIL_FROM=CV Admin <onboarding@resend.dev>
